<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Frostbar</AssemblyName>
    <RootNamespace>Frostbar.App</RootNamespace>
    <StartupObject>Frostbar.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon; WPF windows without an icon of their own (Settings, the dialogs) take it too. Written by
         spikes\Lab (Lab mock ico), design A of the candidates (the user's choice 2026-10-15) -->
    <ApplicationIcon>Assets\Frostbar.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frostbar.Platform\Frostbar.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licenses of the third-party software that ships beside the exe (General › About opens it) -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
